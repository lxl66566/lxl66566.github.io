{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "printWidth": 80,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "sortImports": {},
  "sortPackageJson": true,
  "sortTailwindcss": {},
  "ignorePatterns": [
    ".agents",
    "dist",
    "coverage",
    "node_modules",
    "pnpm-lock.yaml",
    "docs",
    "src"
  ]
}
